# ==============================================================================
# Lentera Pustaka — Konfigurasi Lingkungan (Next.js + Cloud Firestore Free Tier)
# ==============================================================================

# Mode backend data:
# - "firestore" : Rekomendasi produksi serverless (Vercel / Netlify / Firebase App Hosting)
#                 menggunakan Firebase Auth + Cloud Firestore Spark (Gratis) tanpa butuh SQLite.
# - "hybrid"    : Default pengembangan lokal (Firestore + SQLite akun demo lokal).
NEXT_PUBLIC_DATA_BACKEND="firestore"

# Email Google Super Admin perdana (harus sama dengan email bootstrap di firestore.rules)
NEXT_PUBLIC_BOOTSTRAP_ADMIN_EMAIL="admin-sekolah@gmail.com"

# Konfigurasi Firebase Web SDK (opsional jika menggunakan firebase-applet-config.json bawaan;
# isi jika men-deploy ke proyek Firebase Spark pribadi Anda sendiri)
# NEXT_PUBLIC_FIREBASE_API_KEY="AIza..."
# NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN="nama-proyek.firebaseapp.com"
# NEXT_PUBLIC_FIREBASE_PROJECT_ID="nama-proyek"
# NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET="nama-proyek.firebasestorage.app"
# NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID="1234567890"
# NEXT_PUBLIC_FIREBASE_APP_ID="1:1234567890:web:abcdef"
# Untuk Firestore Free Tier (Spark Plan) standar, gunakan "(default)"
# NEXT_PUBLIC_FIREBASE_DATABASE_ID="(default)"

# URL publik aplikasi setelah deploy
APP_URL="https://perpustakaan-sekolah.vercel.app"

# Opsional: Hanya dipakai pada mode "hybrid" (SQLite lokal)
SESSION_SECRET="CHANGE_ME_FOR_PRODUCTION"
LIBRARY_DB_PATH="./data/library.db"
GEMINI_API_KEY="MY_GEMINI_API_KEY"
